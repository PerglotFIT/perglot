{% comment %}
  Shop by Category Section
  Fully customizable grid of category cards with images and links
{% endcomment %}

<section class="shop-category-{{ section.id }}" style="
  padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  background: {{ section.settings.background_color }};
">
  <div class="container container-{{ section.id }}" style="max-width: {{ section.settings.container_width }}px; margin: 0 auto; padding: 0 20px;">
    <div class="section-header section-header-{{ section.id }}" style="
      margin-bottom: {{ section.settings.header_margin_bottom }}px;
      text-align: center !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      width: 100% !important;
    ">
      <h2 class="section-title section-title-{{ section.id }}" style="
        font-size: {{ section.settings.title_font_size }}px;
        font-weight: {{ section.settings.title_font_weight }};
        margin-bottom: {{ section.settings.title_margin_bottom }}px;
        color: {{ section.settings.title_color }};
        text-align: center !important;
        display: block !important;
        width: 100% !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
      ">{{ section.settings.title }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="section-subtitle section-subtitle-{{ section.id }}" style="
          font-size: {{ section.settings.subtitle_font_size }}px;
          color: {{ section.settings.subtitle_color }};
          max-width: {{ section.settings.subtitle_max_width }}px;
          margin: 0 auto;
          line-height: {{ section.settings.subtitle_line_height }};
          text-align: center !important;
          display: block !important;
        ">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>
    
    <div class="category-grid" style="
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax({{ section.settings.card_min_width }}px, 1fr));
      gap: {{ section.settings.grid_gap }}px;
    ">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" 
           class="category-card category-card-{{ section.id }}" 
           {{ block.shopify_attributes }}
           style="
             height: {{ section.settings.card_height }}px;
             border-radius: {{ section.settings.card_border_radius }}px;
             border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
           ">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | img_url: '800x' }}" 
                 alt="{{ block.settings.name }}" 
                 class="category-image category-image-{{ section.id }}"
                 loading="lazy"
                 style="
                   filter: brightness({{ section.settings.image_brightness }}%);
                 ">
          {% else %}
            <div class="category-image category-placeholder category-placeholder-{{ section.id }}" style="
              background: {{ section.settings.placeholder_gradient }} !important;
            "></div>
          {% endif %}
          
          <div class="category-overlay category-overlay-{{ section.id }}" style="
            background: {{ section.settings.overlay_gradient }};
            padding: {{ section.settings.overlay_padding }}px;
          ">
            <div class="category-content" style="
              text-align: {{ section.settings.content_alignment }};
            ">
              <h3 class="category-name" style="
                font-size: {{ section.settings.category_name_font_size }}px;
                font-weight: {{ section.settings.category_name_font_weight }};
                margin-bottom: {{ section.settings.category_name_margin_bottom }}px;
                color: {{ section.settings.category_name_color }};
              ">
                {% if section.settings.show_icons %}{{ block.settings.icon }} {% endif %}{{ block.settings.name }}
              </h3>
              <span class="category-link-text" style="
                color: {{ section.settings.link_text_color }};
                font-weight: {{ section.settings.link_text_font_weight }};
                font-size: {{ section.settings.link_text_font_size }}px;
              ">{{ block.settings.link_text }} →</span>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .shop-category-{{ section.id }} .container-{{ section.id }} {
    display: block !important;
    float: none !important;
  }

  .shop-category-{{ section.id }} .section-header-{{ section.id }} {
    text-align: center !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100% !important;
    float: none !important;
  }

  .shop-category-{{ section.id }} .section-title-{{ section.id }} {
    text-align: center !important;
    display: block !important;
    width: 100% !important;
    float: none !important;
    clear: both !important;
  }

  .shop-category-{{ section.id }} .section-subtitle-{{ section.id }} {
    text-align: center !important;
    display: block !important;
    float: none !important;
    clear: both !important;
  }

  .category-card-{{ section.id }} {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: all {{ section.settings.transition_duration }}s {{ section.settings.transition_timing }};
    text-decoration: none;
  }

  {% if section.settings.enable_hover_effect %}
  .category-card-{{ section.id }}:hover {
    transform: scale({{ section.settings.hover_scale }});
    box-shadow: {{ section.settings.hover_shadow }};
  }
  
  .category-card-{{ section.id }}:hover .category-image-{{ section.id }} {
    filter: brightness({{ section.settings.image_hover_brightness }}%);
    transform: scale({{ section.settings.image_hover_scale }});
  }
  
  .category-card-{{ section.id }}:hover .category-overlay-{{ section.id }} {
    background: {{ section.settings.overlay_hover_gradient }};
  }
  {% endif %}

  .category-image-{{ section.id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all {{ section.settings.transition_duration }}s {{ section.settings.transition_timing }};
  }

  .category-placeholder {
    width: 100%;
    height: 100%;
  }

  .category-placeholder-{{ section.id }} {
    background: {{ section.settings.placeholder_gradient }} !important;
    width: 100%;
    height: 100%;
    position: relative;
  }

  /* Force placeholder styling even after translation */
  .shop-category-{{ section.id }} .category-placeholder-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background: {{ section.settings.placeholder_gradient }};
    z-index: 0;
  }

  .category-overlay-{{ section.id }} {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: {{ section.settings.overlay_vertical_align }};
    transition: all {{ section.settings.transition_duration }}s {{ section.settings.transition_timing }};
  }

  .category-content {
    width: 100%;
  }

  .category-link-text {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  @media (max-width: {{ section.settings.mobile_breakpoint }}px) {
    .shop-category-{{ section.id }} {
      padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px !important;
    }
    
    .section-title-{{ section.id }} {
      font-size: {{ section.settings.mobile_title_font_size }}px !important;
    }
    
    .section-subtitle-{{ section.id }} {
      font-size: {{ section.settings.mobile_subtitle_font_size }}px !important;
    }
    
    .category-grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr) !important;
      gap: {{ section.settings.mobile_grid_gap }}px !important;
    }
    
    .category-card-{{ section.id }} {
      height: {{ section.settings.mobile_card_height }}px !important;
    }
    
    .category-name {
      font-size: {{ section.settings.mobile_category_name_font_size }}px !important;
    }
    
    .category-overlay-{{ section.id }} {
      padding: {{ section.settings.mobile_overlay_padding }}px !important;
    }
  }
</style>

