{% comment %}
  Hero Section with Full Width Image and Top Text
  Image covers full width, text centered at top
{% endcomment %}

<style>
  .hero-section-{{ section.id }} {
    position: relative;
    width: 100%;
    height: {{ section.settings.section_height }}px;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: {{ section.settings.text_top_spacing }}px;
  }
  
  .hero-background-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }
  
  .hero-content {
    position: relative;
    z-index: 3;
    text-align: center;
    max-width: {{ section.settings.content_max_width }}px;
    padding: 0 20px;
  }
  
  .hero-title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: {{ section.settings.title_weight }};
    color: {{ section.settings.title_color }};
    margin: 0;
    line-height: 1.2;
    text-transform: {{ section.settings.title_transform }};
    letter-spacing: {{ section.settings.title_letter_spacing }}px;
    text-shadow: {{ section.settings.text_shadow_x }}px {{ section.settings.text_shadow_y }}px {{ section.settings.text_shadow_blur }}px {{ section.settings.text_shadow_color }};
  }
  
  .hero-subtitle {
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: {{ section.settings.subtitle_weight }};
    color: {{ section.settings.subtitle_color }};
    margin-top: {{ section.settings.subtitle_spacing }}px;
    line-height: 1.4;
    text-shadow: {{ section.settings.text_shadow_x }}px {{ section.settings.text_shadow_y }}px {{ section.settings.text_shadow_blur }}px {{ section.settings.text_shadow_color }};
  }
  
  @media (max-width: 768px) {
    .hero-section-{{ section.id }} {
      height: {{ section.settings.section_height_mobile }}px;
      padding-top: {{ section.settings.text_top_spacing_mobile }}px;
    }
    
    .hero-title {
      font-size: {{ section.settings.title_size_mobile }}px;
    }
    
    .hero-subtitle {
      font-size: {{ section.settings.subtitle_size_mobile }}px;
    }
  }
</style>

<section class="hero-section-{{ section.id }}">
  
  <!-- Background Image -->
  {% if section.settings.background_image != blank %}
    {{ section.settings.background_image | image_url: width: 2400 | image_tag: 
      class: 'hero-background-image',
      loading: 'eager',
      alt: section.settings.title
    }}
  {% else %}
    <!-- Fallback gradient if no image -->
    <div class="hero-background-image" style="background: linear-gradient(135deg, {{ section.settings.fallback_gradient_start }} 0%, {{ section.settings.fallback_gradient_end }} 100%);"></div>
  {% endif %}
  
  <!-- Overlay -->
  {% if section.settings.show_overlay %}
  <div class="hero-overlay"></div>
  {% endif %}
  
  <!-- Content -->
  <div class="hero-content">
    {% if section.settings.title != blank %}
    <h1 class="hero-title">
      {{ section.settings.title }}
    </h1>
    {% endif %}
    
    {% if section.settings.subtitle != blank %}
    <p class="hero-subtitle">
      {{ section.settings.subtitle }}
    </p>
    {% endif %}
  </div>
  
</section>

{% schema %}
{
  "name": "Hero с пълна снимка",
  "settings": [
    {
      "type": "header",
      "content": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Фонова снимка",
      "info": "Препоръчано: 2400x800px (wide landscape)"
    },
    {
      "type": "color",
      "id": "fallback_gradient_start",
      "label": "Fallback gradient start (ако няма снимка)",
      "default": "#3b82f6"
    },
    {
      "type": "color",
      "id": "fallback_gradient_end",
      "label": "Fallback gradient end (ако няма снимка)",
      "default": "#2563eb"
    },
    {
      "type": "header",
      "content": "Overlay Settings"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show dark overlay",
      "default": true,
      "info": "Помага за по-добра четимост на текста"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Section Size"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section height (Desktop)",
      "min": 300,
      "max": 1000,
      "step": 50,
      "default": 600,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_height_mobile",
      "label": "Section height (Mobile)",
      "min": 200,
      "max": 800,
      "step": 50,
      "default": 400,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_top_spacing",
      "label": "Text position from top (Desktop)",
      "min": 0,
      "max": 300,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_top_spacing_mobile",
      "label": "Text position from top (Mobile)",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 400,
      "max": 1400,
      "step": 50,
      "default": 1000,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Title Settings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title text",
      "default": "САМО ЗА BMW"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size (Desktop)",
      "min": 24,
      "max": 120,
      "step": 2,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Title size (Mobile)",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 42,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ],
      "default": "800"
    },
    {
      "type": "select",
      "id": "title_transform",
      "label": "Title text transform",
      "options": [
        {
          "value": "none",
          "label": "Normal"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "lowercase",
          "label": "lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "title_letter_spacing",
      "label": "Title letter spacing",
      "min": -2,
      "max": 20,
      "step": 1,
      "default": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Subtitle Settings"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle text",
      "info": "Optional subtitle below title"
    },
    {
      "type": "range",
      "id": "subtitle_spacing",
      "label": "Space between title and subtitle",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle size (Desktop)",
      "min": 14,
      "max": 48,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subtitle_size_mobile",
      "label": "Subtitle size (Mobile)",
      "min": 12,
      "max": 32,
      "step": 2,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#e5e7eb"
    },
    {
      "type": "select",
      "id": "subtitle_weight",
      "label": "Subtitle weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "header",
      "content": "Text Shadow (за по-добра четимост)"
    },
    {
      "type": "range",
      "id": "text_shadow_x",
      "label": "Shadow X offset",
      "min": -10,
      "max": 10,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_shadow_y",
      "label": "Shadow Y offset",
      "min": -10,
      "max": 10,
      "step": 1,
      "default": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_shadow_blur",
      "label": "Shadow blur",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "text_shadow_color",
      "label": "Shadow color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Hero с пълна снимка",
      "settings": {
        "title": "САМО ЗА BMW",
        "title_size": 72,
        "title_color": "#ffffff",
        "section_height": 600,
        "text_top_spacing": 60,
        "show_overlay": true,
        "overlay_opacity": 30
      }
    }
  ]
}
{% endschema %}
