{% comment %}
  IPTV Highlight Section - Enhanced Version
  Full control over colors, spacing, responsive design
{% endcomment %}

<section class="iptv-highlight" style="
  --section-padding-top: {{ section.settings.section_padding_top }}px;
  --section-padding-bottom: {{ section.settings.section_padding_bottom }}px;
  --section-padding-top-mobile: {{ section.settings.section_padding_top_mobile }}px;
  --section-padding-bottom-mobile: {{ section.settings.section_padding_bottom_mobile }}px;
  --gradient-color-1: {{ section.settings.gradient_color_1 }};
  --gradient-color-2: {{ section.settings.gradient_color_2 }};
  --text-color: {{ section.settings.text_color }};
  --title-size: {{ section.settings.title_size }}px;
  --title-size-mobile: {{ section.settings.title_size_mobile }}px;
  --description-size: {{ section.settings.description_size }}px;
  --description-size-mobile: {{ section.settings.description_size_mobile }}px;
  --stat-number-color: {{ section.settings.stat_number_color }};
  --stat-number-size: {{ section.settings.stat_number_size }}px;
  --stat-number-size-mobile: {{ section.settings.stat_number_size_mobile }}px;
  --content-gap: {{ section.settings.content_gap }}px;
  --content-gap-mobile: {{ section.settings.content_gap_mobile }}px;
  --image-border-radius: {{ section.settings.image_border_radius }}px;
  ">
  <div class="iptv-container">
    <div class="iptv-content">
      <div class="iptv-text">
        {% if section.settings.title != blank %}
          <h2 class="iptv-title">{{ section.settings.title }}</h2>
        {% endif %}
        
        {% if section.settings.description != blank %}
          <p class="iptv-description">{{ section.settings.description }}</p>
        {% endif %}
        
        {% if section.blocks.size > 0 %}
          <div class="iptv-stats">
            {% for block in section.blocks %}
              {% if block.type == 'stat' %}
                <div class="stat-item" {{ block.shopify_attributes }}>
                  <span class="stat-number">{{ block.settings.number }}</span>
                  <span class="stat-label">{{ block.settings.label }}</span>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.streaming_services != blank %}
          <div class="streaming-logos">
            {% assign logos = section.settings.streaming_services | split: '|' %}
            {% for logo in logos %}
              <span class="streaming-logo" style="
                background: {{ section.settings.logo_bg_color }};
                color: {{ section.settings.logo_text_color }};
                ">{{ logo }}</span>
            {% endfor %}
          </div>
        {% endif %}

        <div class="iptv-buttons">
          {% if section.settings.button_1_text != blank %}
            <a href="{{ section.settings.button_1_link }}" class="iptv-btn iptv-btn-primary" style="
              background: {{ section.settings.button_1_bg_color }};
              color: {{ section.settings.button_1_text_color }};
              padding: {{ section.settings.button_padding_v }}px {{ section.settings.button_padding_h }}px;
              font-size: {{ section.settings.button_text_size }}px;
              border-radius: {{ section.settings.button_radius }}px;
              ">
              {{ section.settings.button_1_text }}
            </a>
          {% endif %}
          
          {% if section.settings.button_2_text != blank %}
            <a href="{{ section.settings.button_2_link }}" class="iptv-btn iptv-btn-secondary" style="
              background: {{ section.settings.button_2_bg_color }};
              color: {{ section.settings.button_2_text_color }};
              padding: {{ section.settings.button_padding_v }}px {{ section.settings.button_padding_h }}px;
              font-size: {{ section.settings.button_text_size }}px;
              border-radius: {{ section.settings.button_radius }}px;
              border: 2px solid {{ section.settings.button_2_border_color }};
              ">
              {{ section.settings.button_2_text }}
            </a>
          {% endif %}
        </div>
      </div>
      
      <div class="iptv-image">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | img_url: '1000x' }}" 
               alt="{{ section.settings.image_alt | default: 'IPTV Streaming' }}"
               loading="lazy">
        {% else %}
          <div class="iptv-placeholder">
            <svg width="100" height="100" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="100" height="100" fill="rgba(255,255,255,0.1)"/>
              <path d="M50 30L70 50L50 70L30 50L50 30Z" fill="rgba(255,255,255,0.2)"/>
            </svg>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  .iptv-highlight {
    padding: var(--section-padding-top) 0 var(--section-padding-bottom);
    background: linear-gradient(135deg, var(--gradient-color-1) 0%, var(--gradient-color-2) 100%);
    color: var(--text-color);
    position: relative;
    overflow: hidden;
  }

  .iptv-highlight::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.05) 0%, transparent 50%);
    pointer-events: none;
  }

  .iptv-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .iptv-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--content-gap);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .iptv-text {
    display: flex;
    flex-direction: column;
  }

  .iptv-title {
    font-size: var(--title-size);
    font-weight: 700;
    margin-bottom: 20px;
    line-height: 1.2;
    color: var(--text-color);
  }

  .iptv-description {
    font-size: var(--description-size);
    margin-bottom: 30px;
    opacity: 0.95;
    line-height: 1.7;
    color: var(--text-color);
  }

  .iptv-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: 25px;
    margin-bottom: 35px;
  }

  .stat-item {
    text-align: center;
    padding: 15px;
    background: rgba(255,255,255,0.08);
    border-radius: 12px;
    transition: transform 0.3s ease, background 0.3s ease;
  }

  .stat-item:hover {
    transform: translateY(-3px);
    background: rgba(255,255,255,0.12);
  }

  .stat-number {
    font-size: var(--stat-number-size);
    font-weight: 700;
    color: var(--stat-number-color);
    display: block;
    margin-bottom: 5px;
    line-height: 1;
  }

  .stat-label {
    font-size: 14px;
    opacity: 0.9;
    color: var(--text-color);
  }

  .iptv-image {
    position: relative;
  }

  .iptv-image img {
    width: 100%;
    height: auto;
    border-radius: var(--image-border-radius);
    box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    transition: transform 0.3s ease;
  }

  .iptv-image img:hover {
    transform: scale(1.02);
  }

  .iptv-placeholder {
    width: 100%;
    aspect-ratio: 16/9;
    background: rgba(255,255,255,0.1);
    border-radius: var(--image-border-radius);
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(10px);
  }

  .streaming-logos {
    display: flex;
    gap: 15px;
    margin-bottom: 35px;
    flex-wrap: wrap;
    align-items: center;
  }

  .streaming-logo {
    padding: 10px 18px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    white-space: nowrap;
  }

  .streaming-logo:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
  }

  .iptv-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
  }

  .iptv-btn {
    border: none;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
    text-align: center;
  }

  .iptv-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
    opacity: 0.95;
  }

  .iptv-btn-secondary:hover {
    opacity: 0.9;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
  }

  /* Tablet Responsive */
  @media (max-width: 1024px) {
    .iptv-container {
      padding: 0 30px;
    }

    .iptv-content {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .iptv-image {
      order: -1;
    }

    .iptv-stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .iptv-highlight {
      padding: var(--section-padding-top-mobile) 0 var(--section-padding-bottom-mobile);
    }

    .iptv-container {
      padding: 0 20px;
    }

    .iptv-content {
      gap: var(--content-gap-mobile);
    }

    .iptv-title {
      font-size: var(--title-size-mobile) !important;
      line-height: 1.3;
      margin-bottom: 15px;
    }

    .iptv-description {
      font-size: var(--description-size-mobile) !important;
      margin-bottom: 25px;
    }

    .iptv-stats {
      grid-template-columns: 1fr;
      gap: 15px;
      margin-bottom: 25px;
    }

    .stat-item {
      padding: 12px;
    }

    .stat-number {
      font-size: var(--stat-number-size-mobile) !important;
    }

    .stat-label {
      font-size: 12px;
    }

    .streaming-logos {
      gap: 10px;
      margin-bottom: 25px;
    }

    .streaming-logo {
      padding: 8px 14px;
      font-size: 12px;
    }

    .iptv-buttons {
      flex-direction: column;
      width: 100%;
    }

    .iptv-btn {
      width: 100%;
      justify-content: center;
    }
  }

  /* Small Mobile */
  @media (max-width: 480px) {
    .iptv-container {
      padding: 0 15px;
    }

    .streaming-logos {
      justify-content: center;
    }
  }
</style>

