
<div class="compare-table-wrapper section-{{ section.id }}-padding isolate">
 <div class="b-compare-table l page-width">
 <div class="c-title-v1">
     <div class="inner">
       <h2 class="rich-text__heading rte {{ section.settings.heading_size }}" {{ section.shopify_attributes }}>
                {{ section.settings.heading | replace: 'p>', 'span>' }}
        </h2>
         {{ section.settings.des  }}
    </div>
</div>


<div class="b-compare-table__content">
   <div class="b-compare-table__wrapper">
     <div class="zone fixed-zone">
       <div class="col">
         {% for block in section.blocks %}
         <div class="cell"><p>{{ block.settings.title }}</p></div>
         {% endfor %}
      </div>
       
     <div class="col">
       
       
       

     <div class="cell">
     <div class="logo">
         <img loading="lazy" src="{{ section.settings.logo | img_url: '200x' }}" alt="{{ section.settings.logo.alt }}">
    </div>
  </div>

 
 
 
 
 {% for block in section.blocks %}
   
   <div class="cell">
     
     <span class="circle">
       {% if block.settings.block_value != blank %}
         {{ block.settings.block_value }}
         {% else %}
          {% if block.settings.this_store == 'yes' %}
           <svg width="24" height="20" viewBox="0 0 24 20" fill="none" xmlns="http://www.w3.org/2000/svg">
           <path d="M1 10L9 17L22.5 1.5" stroke="white" stroke-width="3"></path>
          </svg>
         {% else %}
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
           <path d="M22 2L2 22" stroke="white" stroke-width="3"></path>
           <path d="M2 2L22 22" stroke="white" stroke-width="3"></path>
          </svg>
         {% endif %}
        {% endif %}
        </span>
    </div>




         {% endfor %}
    
     </div>
       
    </div>

         
     <div class="swiper-table">
     <div class="zone scroll-zone swiper-wrapper" id="swiper-wrapper-3ee840bc8ce45b2c" aria-live="polite">
     <!--
     <div class='them'> -->
     <div class="col swiper-slide">
      <div class="cell">
       <p>{{ section.settings.other }}</p>
     </div>
       

       {% for block in section.blocks %}
   <div class="cell">

     <span class="circle right_table_feature">
       {% if block.settings.block_value != blank %}
         {{ block.settings.block_value }}
         {% else %}
          {% if block.settings.other_store == 'yes' %}
           <svg width="24" height="20" viewBox="0 0 24 20" fill="none" xmlns="http://www.w3.org/2000/svg">
           <path d="M1 10L9 17L22.5 1.5" stroke="white" stroke-width="3"></path>
          </svg>
         {% else %}
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
           <path d="M22 2L2 22" stroke="{{ section.settings.circle_bg_right_c }}" stroke-width="3"></path>
           <path d="M2 2L22 22" stroke="{{ section.settings.circle_bg_right_c }}" stroke-width="3"></path>
          </svg>
         {% endif %}
        {% endif %}
        </span>
     
   </div>
  {% endfor %} 
  

       
     </div>
     
     
     <!--
    </div> -->
    </div>
     <div class="swiper-pagination swiper-table-pagination"></div>
    </div>
  </div>
</div>
 </div>
</div>
