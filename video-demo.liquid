{% comment %}
  Video Demo Section
  Split section with video and content
{% endcomment %}

<section class="video-demo">
  <div class="container">
    <div class="demo-split">
      <div class="demo-video">
        {% if section.settings.video_url != blank %}
          <video autoplay muted loop playsinline>
            <source src="{{ section.settings.video_url }}" type="video/mp4">
          </video>
        {% elsif section.settings.video_image != blank %}
          <img src="{{ section.settings.video_image | img_url: '800x' }}" 
               alt="Video placeholder"
               loading="lazy">
        {% else %}
          <div class="video-placeholder"></div>
        {% endif %}
      </div>
      
      <div class="demo-content">
        <h2>{{ section.settings.title }}</h2>
        
        {% if section.settings.description != blank %}
          <div class="demo-description">
            {{ section.settings.description }}
          </div>
        {% endif %}
        
        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link }}" class="btn btn-primary">
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  .video-demo {
    padding: 80px 0;
    background: #f8f9fa;
  }

  .demo-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .demo-video {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(0,0,0,0.2);
  }

  .demo-video video,
  .demo-video img {
    width: 100%;
    display: block;
  }

  .video-placeholder {
    width: 100%;
    height: 400px;
    background: linear-gradient(135deg, #2B5FA8 0%, #1E4A7C 100%);
  }

  .demo-content h2 {
    font-size: 36px;
    font-weight: 700;
    margin-bottom: 20px;
    line-height: 1.3;
    color: #1a1a1a;
  }

  .demo-description {
    font-size: 18px;
    color: #666;
    margin-bottom: 30px;
    line-height: 1.7;
  }

  .demo-description p {
    margin-bottom: 20px;
  }

  @media (max-width: 1024px) {
    .demo-split {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .demo-content h2 {
      font-size: 28px;
    }
  }
</style>

{% schema %}
{
  "name": "Video Demo",
  "settings": [
    {
      "type": "header",
      "content": "Video Settings"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "info": "Direct link to .mp4 file"
    },
    {
      "type": "image_picker",
      "id": "video_image",
      "label": "Video Placeholder Image",
      "info": "Shows if no video URL is provided"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Все още питате дали работи по време на шофиране?"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Да — всеки път. Вижте как водачи по целия свят се наслаждават на Netflix, YouTube и любимите си приложения.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Вижте отзивите"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Video Demo"
    }
  ]
}
{% endschema %}
