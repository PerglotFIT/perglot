{% doc %}
  @prompt
    I want a heading text at the beggining of the page. The heading should state Наслади се на безпроблемно забавление – дори по време на път with description which states - С нашия IPTV абонамент, превръщаш всяко пътуване в удоволствие. Гледай над 120 356+ телевизионни канала, премиум сериали и филми директно от екрана на автомобила си., Create a new section with a large bold headline in all caps, centered, saying:
    "НАСЛАДИ СЕ НА БЕЗПРОБЛЕМНО ЗАБАВЛЕНИЕ – ДОРИ ПО ВРЕМЕ НА ПЪТ"
    
    Under the headline, add a subheading/paragraph, centered, in smaller font, that says:
    "С нашия IPTV абонамент, превръщаш всяко пътуване в удоволствие. Гледай над 120 356+ телевизионни канала, премиум сериали и филми директно от екрана на автомобила си."
    
    Style details:
    
    Headline font: bold, uppercase, dark blue (#0C1B3A).
    
    Subtext: regular font, black (#000000), with bold emphasis on IPTV абонамент and 120 356+ телевизионни канала, премиум сериали и филми.
    
    Alignment: everything should be centered.
    
    Background: white.
    
    Section should have balanced padding (top and bottom ~60px).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-heading-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    text-align: center;
    background-color: {{ block.settings.background_color }};
  }

  .ai-hero-heading__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-hero-heading__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.spacing_between }}px 0;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .ai-hero-heading__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin: 0 auto;
    max-width: {{ block.settings.description_max_width }}px;
  }

  .ai-hero-heading__description-{{ ai_gen_id }} strong {
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-heading__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
      letter-spacing: 0.01em;
    }

    .ai-hero-heading__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-hero-heading__container-{{ ai_gen_id }} {
      padding: 0 16px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-hero-heading__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
    }
  }
{% endstyle %}

<div class="ai-hero-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-heading__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h1 class="ai-hero-heading__title-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h1>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="ai-hero-heading__description-{{ ai_gen_id }}">
        {{ block.settings.description }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Hero heading",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Наслади се на безпроблемно забавление – дори по време на път"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>С нашия <strong>IPTV абонамент</strong>, превръщаш всяко пътуване в удоволствие. Гледай над <strong>120 356+ телевизионни канала, премиум сериали и филми</strong> директно от екрана на автомобила си.</p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 56
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#0C1B3A"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 16,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 20
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "description_max_width",
      "min": 500,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Description max width",
      "default": 700
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "spacing_between",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Space between heading and description",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Hero heading"
    }
  ]
}
{% endschema %}