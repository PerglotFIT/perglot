      "id": "step_1_number",
      "label": "Step number",
      "default": 1
    },
    {
      "type": "text",
      "id": "step_1_title",
      "label": "Title",
      "default": "Purchase a plan"
    },
    {
      "type": "textarea",
      "id": "step_1_description",
      "label": "Description",
      "default": "Choose the IPTV plan that best fits your needs and complete your purchase"
    },
    {
      "type": "header",
      "content": "Step 2"
    },
    {
      "type": "image_picker",
      "id": "step_2_icon",
      "label": "Icon"
    },
    {
      "type": "number",
      "id": "step_2_number",
      "label": "Step number",
      "default": 2
    },
    {
      "type": "text",
      "id": "step_2_title",
      "label": "Title",
      "default": "Receive activation code"
    },
    {
      "type": "textarea",
      "id": "step_2_description",
      "label": "Description",
      "default": "Get your activation code and detailed email instructions within minutes of purchase"
    },
    {
      "type": "header",
      "content": "Step 3"
    },
    {
      "type": "image_picker",
      "id": "step_3_icon",
      "label": "Icon"
    },
    {
      "type": "number",
      "id": "step_3_number",
      "label": "Step number",
      "default": 3
    },
    {
      "type": "text",
      "id": "step_3_title",
      "label": "Title",
      "default": "Enter code and start watching"
