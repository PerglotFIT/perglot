{% doc %}
  @prompt
    Create a new section with two columns:
    
    Left column: a list with icons and text:
    
    📺 Over 18,000 TV channels from all around the world
    
    🎬 Movies and series from Netflix, Amazon Prime, HBO and more
    
    🔊 Multi-language audio: Italian, French, Polish, Romanian, English, German, Bulgarian, Turkish, and many others
    
    😀 Kids channels – Cartoon Network, Baby TV, Disney and more
    
    🏅 HD / Full HD / 4K quality
    
    ⏰ 24/7 uninterrupted access
    
    🌍 Access to national and international channels: not only hundreds of free ones, but also premium (paid) TV channels that usually require a separate subscription
    
    Each row should have an icon on the left and text on the right (make keywords bold).
    
    Use dark blue color (#0C1B3A) for highlights.
    
    Arrange the text vertically with enough spacing between rows.
    
    Right column: an image (example: a TV screen showing a channel list).
    
    Style: white background, balanced padding, centered layout, clean and modern design.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-features-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-features-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }

  .ai-features-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.row_spacing }}px;
  }

  .ai-features-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: {{ block.settings.icon_text_gap }}px;
  }

  .ai-features-icon-{{ ai_gen_id }} {
    font-size: {{ block.settings.icon_size }}px;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .ai-features-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    flex-grow: 1;
  }

  .ai-features-text-{{ ai_gen_id }} strong {
    color: {{ block.settings.highlight_color }};
    font-weight: 600;
  }

  .ai-features-image-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-features-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .ai-features-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    max-width: 500px;
    aspect-ratio: 16/10;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .ai-features-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-features-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 768px) {
    .ai-features-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-features-section-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding }}px 20px;
    }

    .ai-features-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }

    .ai-features-icon-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_icon_size }}px;
    }
  }
{% endstyle %}

<div class="ai-features-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-features-container-{{ ai_gen_id }}">
    <div class="ai-features-list-{{ ai_gen_id }}">
      {% if block.settings.feature_1_enabled %}
        <div class="ai-features-item-{{ ai_gen_id }}">
          <div class="ai-features-icon-{{ ai_gen_id }}">{{ block.settings.feature_1_icon }}</div>
          <div class="ai-features-text-{{ ai_gen_id }}">{{ block.settings.feature_1_text }}</div>
        </div>
      {% endif %}

      {% if block.settings.feature_2_enabled %}
        <div class="ai-features-item-{{ ai_gen_id }}">
          <div class="ai-features-icon-{{ ai_gen_id }}">{{ block.settings.feature_2_icon }}</div>
          <div class="ai-features-text-{{ ai_gen_id }}">{{ block.settings.feature_2_text }}</div>
        </div>
      {% endif %}

      {% if block.settings.feature_3_enabled %}
        <div class="ai-features-item-{{ ai_gen_id }}">
          <div class="ai-features-icon-{{ ai_gen_id }}">{{ block.settings.feature_3_icon }}</div>
          <div class="ai-features-text-{{ ai_gen_id }}">{{ block.settings.feature_3_text }}</div>
        </div>
      {% endif %}

      {% if block.settings.feature_4_enabled %}
        <div class="ai-features-item-{{ ai_gen_id }}">
          <div class="ai-features-icon-{{ ai_gen_id }}">{{ block.settings.feature_4_icon }}</div>
          <div class="ai-features-text-{{ ai_gen_id }}">{{ block.settings.feature_4_text }}</div>
        </div>
      {% endif %}

      {% if block.settings.feature_5_enabled %}
        <div class="ai-features-item-{{ ai_gen_id }}">
          <div class="ai-features-icon-{{ ai_gen_id }}">{{ block.settings.feature_5_icon }}</div>
          <div class="ai-features-text-{{ ai_gen_id }}">{{ block.settings.feature_5_text }}</div>
        </div>
      {% endif %}

      {% if block.settings.feature_6_enabled %}
        <div class="ai-features-item-{{ ai_gen_id }}">
          <div class="ai-features-icon-{{ ai_gen_id }}">{{ block.settings.feature_6_icon }}</div>
          <div class="ai-features-text-{{ ai_gen_id }}">{{ block.settings.feature_6_text }}</div>
        </div>
      {% endif %}

      {% if block.settings.feature_7_enabled %}
        <div class="ai-features-item-{{ ai_gen_id }}">
          <div class="ai-features-icon-{{ ai_gen_id }}">{{ block.settings.feature_7_icon }}</div>
          <div class="ai-features-text-{{ ai_gen_id }}">{{ block.settings.feature_7_text }}</div>
        </div>
      {% endif %}
    </div>

    <div class="ai-features-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.feature_image %}
        <img
          src="{{ block.settings.feature_image | image_url: width: 800 }}"
          alt="{{ block.settings.feature_image.alt | escape }}"
          class="ai-features-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.feature_image.width }}"
          height="{{ block.settings.feature_image.height }}"
        >
      {% else %}
        <div class="ai-features-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-features-empty-state-{{ ai_gen_id }}">
            Add an image to showcase your features
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

