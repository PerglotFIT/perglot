{% comment %}
  FAQ Accordion Section - Perglot Edition
  Expandable frequently asked questions with full customization
{% endcomment %}

<section class="faq-section" style="
  --section-padding-top: {{ section.settings.padding_top }}px;
  --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  --bg-color: {{ section.settings.background_color }};
  --title-color: {{ section.settings.title_color }};
  --subtitle-color: {{ section.settings.subtitle_color }};
  --question-bg: {{ section.settings.question_bg_color }};
  --question-text: {{ section.settings.question_text_color }};
  --answer-text: {{ section.settings.answer_text_color }};
  --border-color: {{ section.settings.border_color }};
  --accent-color: {{ section.settings.accent_color }};
  ">
  <div class="faq-container">
    <div class="faq-header" style="text-align: {{ section.settings.text_alignment }};">
      {% if section.settings.title != blank %}
        <h2 class="faq-title" style="
          font-size: {{ section.settings.title_size }}px;
          font-weight: {{ section.settings.title_weight }};
          margin-bottom: {{ section.settings.title_margin }}px;
          ">{{ section.settings.title }}</h2>
      {% endif %}
      
      {% if section.settings.subtitle != blank %}
        <p class="faq-subtitle" style="
          font-size: {{ section.settings.subtitle_size }}px;
          max-width: {{ section.settings.subtitle_max_width }}px;
          ">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>
    
    <div class="faq-list" style="max-width: {{ section.settings.faq_max_width }}px;">
      {% for block in section.blocks %}
        <div class="faq-item" {{ block.shopify_attributes }} style="
          border-radius: {{ section.settings.item_border_radius }}px;
          margin-bottom: {{ section.settings.item_spacing }}px;
          ">
          <button class="faq-question" onclick="toggleFaq(this)" style="
            padding: {{ section.settings.question_padding_v }}px {{ section.settings.question_padding_h }}px;
            font-size: {{ section.settings.question_size }}px;
            ">
            <span>{{ block.settings.question }}</span>
            <span class="faq-icon" style="font-size: {{ section.settings.icon_size }}px;">▼</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-content" style="
              padding: 0 {{ section.settings.question_padding_h }}px {{ section.settings.answer_padding_bottom }}px;
              font-size: {{ section.settings.answer_size }}px;
              line-height: {{ section.settings.answer_line_height }};
              ">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .faq-section {
    padding: var(--section-padding-top) 0 var(--section-padding-bottom);
    background: var(--bg-color);
  }

  .faq-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .faq-header {
    margin-bottom: 50px;
  }

  .faq-title {
    color: var(--title-color);
    line-height: 1.2;
  }

  .faq-subtitle {
    color: var(--subtitle-color);
    margin: 0 auto;
  }

  .faq-list {
    margin: 0 auto;
  }

  .faq-item {
    border: {{ section.settings.border_width }}px solid var(--border-color);
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .faq-item:hover {
    border-color: var(--accent-color);
  }

  .faq-item.active {
    border-color: var(--accent-color);
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
  }

  .faq-question {
    width: 100%;
    text-align: left;
    background: var(--question-bg);
    color: var(--question-text);
    border: none;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: all 0.3s ease;
  }

  .faq-question:hover {
    background: rgba(0,0,0,0.02);
  }

  .faq-item.active .faq-question {
    background: rgba({{ section.settings.accent_color | remove: '#' | split: '' | join: ',' }}{{ section.settings.accent_color | remove: '#' | split: '' | join: ',' }}, 0.05);
  }

  .faq-icon {
    color: var(--accent-color);
    transition: transform 0.3s ease;
    flex-shrink: 0;
    margin-left: 15px;
  }

  .faq-item.active .faq-icon {
    transform: rotate(180deg);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease-out;
  }

  .faq-item.active .faq-answer {
    max-height: 1000px;
    transition: max-height 0.6s ease-in;
  }

  .faq-answer-content {
    color: var(--answer-text);
  }

  .faq-answer-content p {
    margin: 0 0 15px 0;
  }

  .faq-answer-content p:last-child {
    margin-bottom: 0;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .faq-container {
      padding: 0 20px;
    }

    .faq-header {
      margin-bottom: 35px;
    }

    .faq-title {
      font-size: {{ section.settings.mobile_title_size }}px !important;
    }

    .faq-subtitle {
      font-size: {{ section.settings.mobile_subtitle_size }}px !important;
    }

    .faq-question {
      padding: {{ section.settings.mobile_question_padding }}px !important;
      font-size: {{ section.settings.mobile_question_size }}px !important;
    }

    .faq-answer-content {
      padding: 0 {{ section.settings.mobile_question_padding }}px {{ section.settings.mobile_answer_padding }}px !important;
      font-size: {{ section.settings.mobile_answer_size }}px !important;
    }

    .faq-icon {
      font-size: {{ section.settings.mobile_icon_size }}px !important;
    }

    .faq-item {
      margin-bottom: {{ section.settings.mobile_item_spacing }}px !important;
    }
  }
</style>

<script>
  function toggleFaq(button) {
    const faqItem = button.parentElement;
    const wasActive = faqItem.classList.contains('active');
    
    // Close all items
    document.querySelectorAll('.faq-item').forEach(item => {
      item.classList.remove('active');
    });
    
    // Open clicked item if it wasn't active
    if (!wasActive) {
      faqItem.classList.add('active');
    }
  }

  // Optional: Open first item by default
  {% if section.settings.open_first %}
  document.addEventListener('DOMContentLoaded', function() {
    const firstItem = document.querySelector('.faq-item');
    if (firstItem) {
      firstItem.classList.add('active');
    }
  });
  {% endif %}
</script>

