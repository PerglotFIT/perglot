ttom":80,"title_font_size":40,"title_font_weight":"700","title_color":"#1a1a1a","title_margin_bottom":10,"subtitle_font_size":14,"subtitle_color":"#666666","subtitle_max_width":1000,"subtitle_line_height":1.3,"header_margin_bottom":45,"card_min_width":300,"grid_gap":30,"card_height":360,"card_border_radius":8,"card_border_width":3,"card_border_color":"#e0e0e0","image_brightness":100,"placeholder_gradient":"linear-gradient(135deg, #2B5FA8 0%, #1E4A7C 100%)","overlay_gradient":"linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%)","overlay_padding":10,"overlay_vertical_align":"flex-end","content_alignment":"left","enable_hover_effect":true,"hover_scale":1,"hover_shadow":"0 15px 40px rgba(0,0,0,0.15)","image_hover_brightness":110,"image_hover_scale":1.1,"overlay_hover_gradient":"linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 60%)","transition_duration":0.3,"transition_timing":"ease","show_icons":false,"category_name_font_size":28,"category_name_font_weight":"700","category_name_color":"#ffffff","category_name_margin_bottom":16,"link_text_color":"#f4c430","link_text_font_size":16,"link_text_font_weight":"600","mobile_breakpoint":624,"mobile_padding_top":50,"mobile_padding_bottom":50,"mobile_title_font_size":32,"mobile_subtitle_font_size":18,"mobile_columns":"1","mobile_grid_gap":20,"mobile_card_height":270,"mobile_category_name_font_size":22,"mobile_overlay_padding":20}},"faq_home_Y9nMAi":{"type":"faq-home","blocks":{"faq_item_iYcyzk":{"type":"faq_item","settings":{"question":"Кои сте вие и какво правите?","answer":"<p>Perglot е специализиран онлайн магазин за медийни решения за Вашия автомобил. Работим изключително с висококачествени устройства, които разширяват възможностите на автомобилните екрани. Освен това предлагаме IPTV абонаменти чрез нашата услуга Streamo. Обслужваме клиенти в цял свят с фокус върху качество, надеждност и отлично обслужване.<\/p>"}},"faq_item_B8ExRV":{"type":"faq_item","settings":{"question":"Как мога да поръчам от вас?","answer":"<p>Поръчването е изключително лесно - разглеждате нашите продукти, избирате този който ви харесва, добавяте го в количката и завършвате поръчката онлайн. Приемаме плащания с карта, PayPal, банков превод и наложен платеж (в някои страни). След потвърждение на поръчката, изпращаме вашия продукт в рамките на 24 часа.<\/p>"}},"faq_item_UdhiEU":{"type":"faq_item","settings":{"question":"Какви са условията за връщане?","answer":"<p>Предлагаме 30-дневен период за връщане без въпроси. Ако по каквато и да е причина не сте доволни от покупката, можете да върнете продукта за пълно възстановяване на сумата. Продуктът трябва да е в оригиналната си опаковка и неизползван. <\/p>"}},"faq_item_TMiBHK":{"type":"faq_item","settings":{"question":"Предлагате ли гаранция?","answer":"<p>Да! Всички наши продукти идват с минимум 2 години гаранция срещу производствени дефекти. Ако възникне проблем, просто се свържете с нас и ще го решим бързо - или чрез подмяна на продукта, или чрез ремонт. Гаранцията не покрива механични повреди или неправилна употреба. Ние сме тук, за да сме сигурни че сте доволни.<\/p>"}},"faq_item_a3Wm3k":{"type":"faq_item","settings":{"question":"Как мога да получа помощ ако имам проблем?","answer":"<p>Нашият екип за поддръжка е на разположение 24\/7. Можете да се свържете с нас чрез email или WhatsApp чат на сайта. Помагаме с всичко - от избор на правилния продукт, през инсталация, до решаване на технически проблеми. Повечето въпроси решаваме за минути, а за по-сложни случаи предлагаме видео консултации.<\/p>"}},"faq_item_3VHK7h":{"type":"faq_item","settings":{"question":"Оригинални ли са вашите продукти?","answer":"<p>Абсолютно! Работим само с оригинални продукти директно от производителите или техни официални дистрибутори. Всеки продукт идва с оригинална опаковка  и всички необходими аксесоари. Качеството е наш приоритет номер едно и затова избираме само най-добрите производители.<\/p>"}},"faq_item_9xpERY":{"type":"faq_item","settings":{"question":"Какво представлява IPTV услугата?","answer":"<p>IPTV платформа с над 17,500 канала, 84,000 филма и 21,000 сериала. Това включва спорт, новини, филми, сериали и детски канали от цял свят. Можете да я използвате на вашия CarPlay устройство, Smart TV, компютър или мобилно устройство. Абонаментът е без договор.<\/p>"}},"faq_item_pVy6Hb":{"type":"faq_item","settings":{"question":"Имате ли физически магазин?","answer":"<p>В момента работим само онлайн, което ни позволява да предлагаме най-добри цени и бърза доставка. Въпреки че нямаме физически магазин, нашата онлайн поддръжка е на разположение 24\/7 и можем да ви помогнем със всичко - от избор на продукт до инсталация. <\/p>"}},"faq_item_BEBP7E":{"type":"faq_item","settings":{"question":"Защо да избера Perglot вместо други магазини?","answer":"<p>Perglot се специализира единствено в CarPlay и стрийминг решения - това е всичко което правим. Това означава експертни съвети, внимателно подбрани продукти и дълбоко познаване на материята. Предлагаме 30-дневен тест период, 2 години гаранция, 24\/7 поддръжка и хиляди доволни клиенти. Когато купувате от нас, купувате спокойствие.<\/p>"}},"faq_item_bkjtPM":{"type":"faq_item","settings":{"question":"Безопасно ли е да пазарувам при вас?","answer":"<p>Абсолютно! Нашият сайт използва SSL криптиране за защита на вашите данни. Не съхраняваме данни за вашата банкова карта. Работим с проверени платежни системи като Stripe и PayPal. Ние сме регистрирана фирма с ДДС номер и предоставяме фактури за всяка покупка при желание на клиента. Имаме стотици положителни отзиви от реални клиенти и прозрачни условия за връщане.<\/p>"}},"faq_item_T6eG96":{"type":"faq_item","settings":{"question":"Предлагате ли фирмени отстъпки или партньорства?","answer":"<p>Да! За фирмени клиенти, автосервизи, автокъщи и търговци предлагаме специални B2B условия с по-добри цени при по-големи количества. Можем да предоставим и маркетингови материали за вашия бизнес. Свържете се с нас за индивидуална оферта. Работим с множество партньори в цяла Европа.<\/p>"}}},"block_order":["faq_item_iYcyzk","faq_item_B8ExRV","faq_item_UdhiEU","faq_item_TMiBHK","faq_item_a3Wm3k","faq_item_3VHK7h","faq_item_9xpERY","faq_item_pVy6Hb","faq_item_BEBP7E","faq_item_bkjtPM","faq_item_T6eG96"],"name":"FAQ Perglot Store","settings":{"padding_top":20,"padding_bottom":40,"background_color":"#ffffff","faq_max_width":900,"title":"Често задавани въпроси","title_size":40,"title_weight":"700","title_color":"#1a1a1a","title_margin":15,"subtitle":"Имате въпроси? Ние имаме отговори","subtitle_size":18,"subtitle_color":"#666666","subtitle_max_width":700,"text_alignment":"center","question_bg_color":"#ffffff","question_text_color":"#1a1a1a","answer_text_color":"#666666","border_color":"#e0e0e0","border_width":1,"accent_color":"#2b5fa8","item_border_radius":8,"item_spacing":15,"question_size":17,"question_padding_v":25,"question_padding_h":30,"icon_size":20,"answer_size":15,"answer_line_height":1.7,"answer_padding_bottom":25,"open_first":false,"mobile_title_size":28,"mobile_subtitle_size":16,"mobile_question_size":16,"mobile_question_padding":20,"mobile_answer_size":14,"mobile_answer_padding":20,"mobile_icon_size":18,"mobile_item_spacing":10}},"trust_strip_P8kKRh":{"type":"trust-strip","blocks":{"trust_badge_jW3LAV":{"type":"trust_badge","settings":{"icon_image":"shopify:\/\/shop_images\/Eo_circle_green_checkmark_svg.png","icon":"✓","text":"30 Дни Пробен Период"}},"trust_badge_EUUktA":{"type":"trust_badge","settings":{"icon_image":"shopify:\/\/shop_images\/XMLID_1.png","icon":"✓","text":"2 Години Гаранция"}},"trust_badge_YKU9kk":{"type":"trust_badge","settings":{"icon_image":"shopify:\/\/shop_images\/WhatsApp_svg_d1a40f5e-4a54-43d0-be6f-86bb361a5d86.webp","icon":"💬","text":"24\/7 Поддръжка"}}},"block_order":["trust_badge_jW3LAV","trust_badge_EUUktA","trust_badge_YKU9kk"],"name":"Trust Strip Pro","settings":{"section_padding":25,"section_padding_mobile":30,"container_max_width":1400,"items_gap":65,"badges_gap":30,"background_color"