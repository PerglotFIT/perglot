_level":3,"background":"#ffffff","background_gradient":"","text_color":"","input_background":"#f0f0f0","input_text_color":""}},"3f59cfff-c548-49a8-8a7d-103de18bcfb8":{"type":"rich-text","blocks":{"template--18463718375692__3f59cfff-c548-49a8-8a7d-103de18bcfb8-subheading-1":{"type":"subheading","disabled":true,"settings":{"text":"Subheading"}},"template--18463718375692__3f59cfff-c548-49a8-8a7d-103de18bcfb8-heading-1":{"type":"heading","settings":{"text":"Защитете очите си и правете шофирането по-безопасно с нашия поляризиран сенник!","heading_tag":"h2","text_color":"","gradient":""}},"8f8f28fe-6858-4239-b13b-eb89fc34709f":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/9.png","width_mode":"full_width","max_width":600,"mobile_max_width":260}},"template--18463718375692__3f59cfff-c548-49a8-8a7d-103de18bcfb8-richtext-1":{"type":"richtext","settings":{"content":"<p>Този висококачествен автомобилен сенник <strong>намалява отблясъците<\/strong> и <strong>предпазва очите ви от ярката слънчева светлина<\/strong> и <strong>заслепяващи фарове<\/strong>, осигурявайки <strong>по-добра видимост<\/strong> и комфорт при шофиране както <strong>през деня<\/strong>, така и <strong>през нощта<\/strong>.<\/p>"}}},"block_order":["template--18463718375692__3f59cfff-c548-49a8-8a7d-103de18bcfb8-subheading-1","template--18463718375692__3f59cfff-c548-49a8-8a7d-103de18bcfb8-heading-1","8f8f28fe-6858-4239-b13b-eb89fc34709f","template--18463718375692__3f59cfff-c548-49a8-8a7d-103de18bcfb8-richtext-1"],"settings":{"full_width":true,"content_width":"small","text_position":"center","background":"#ffffff","background_gradient":"","text_color":""}},"5089d805-19a4-407d-94ea-942fc4d02a13":{"type":"text-with-icons","blocks":{"template--18463718375692__5089d805-19a4-407d-94ea-942fc4d02a13-item-2":{"type":"item","settings":{"icon":"picto-coupon","custom_icon":"shopify:\/\/shop_images\/831682.png","mobile_icon_width":112,"icon_width":84,"icon_background_type":"circle","icon_background":"#ffffff","icon_color":"","title":"Ярка слънчева светлина","content":"<p>Интензивната слънчева светлина може да <strong>напрегне очите ви<\/strong> и да <strong>намали видимостта<\/strong>. <strong>Сенникът <\/strong>ефективно <strong>намалява отблясъците<\/strong>, осигурявайки <strong>комфорт и безопасност<\/strong> при шофиране през деня.<\/p>"}},"template--18463718375692__5089d805-19a4-407d-94ea-942fc4d02a13-item-3":{"type":"item","settings":{"icon":"picto-coupon","custom_icon":"shopify:\/\/shop_images\/1197102.png","mobile_icon_width":104,"icon_width":116,"icon_background_type":"circle","icon_background":"#ffffff","icon_color":"","title":"Мъгла и лоши метеорологични условия","content":"<p>При облачно време, мъгла или дъжд контрастът на пътя може да намалее. <strong>Поляризираният филтър подобрява видимостта<\/strong> и ви помага да се ориентирате по-добре.<\/p>"}},"template--18463718375692__5089d805-19a4-407d-94ea-942fc4d02a13-item-1":{"type":"item","settings":{"icon":"picto-coupon","custom_icon":"shopify:\/\/shop_images\/4395401-200.png","mobile_icon_width":116,"icon_width":104,"icon_background_type":"circle","icon_background":"#ffffff","icon_color":"","title":"Нощно шофиране и заслепяващи фарове","content":"<p>Светлината от насрещните автомобили може да <strong>причини заслепяване и умора на очите.<\/strong> <strong>Жълтият филтър на сенника<\/strong> <strong>намалява отблясъците<\/strong>, <strong>осигурявайки по-ясен поглед върху пътя.<\/strong><\/p><h3><\/h3>"}}},"block_order":["template--18463718375692__5089d805-19a4-407d-94ea-942fc4d02a13-item-2","template--18463718375692__5089d805-19a4-407d-94ea-942fc4d02a13-item-3","template--18463718375692__5089d805-19a4-407d-94ea-942fc4d02a13-item-1"],"settings":{"full_width":true,"stack_on_mobile":false,"title":"Перфектен при всякакви условия!","heading_tag":"h5","text_alignment":"center","icon_spacing":"medium","background":"#ffffff","background_gradient":"","text_color":""}},"rich_text_BYwGrF":{"type":"rich-text","blocks":{"heading_3hgNnk":{"type":"heading","settings":{"text":"Защо да изберете нашия сенник?","heading_tag":"h1","text_color":"","gradient":""}},"richtext_4chMnd":{"type":"richtext","settings":{"content":"<p>✅ <strong>Поляризирани филтри:<\/strong> Намалява вредните отблясъци и повишава контраста за по-добра видимост.<br\/>✅ <strong>Двоен дизайн:<\/strong> Идеален както за дневна, така и за нощна употреба.<br\/>✅ <strong>Лесен монтаж:<\/strong> Бързо и лесно закрепване към съществуващия сенник на автомобила.<br\/>✅ <strong>Регулируем ъгъл:<\/strong> Персонализирайте позицията за максимален комфорт.<br\/>✅ <strong>Висококачествени материали:<\/strong> Издръжлив и устойчив на надраскване.<\/p>"}}},"block_order":["heading_3hgNnk","richtext_4chMnd"],"settings":{"full_width":true,"content_width":"small","text_position":"center","background":"","background_gradient":"","text_color":""}},"cf988c16-5b76-4c17-b8a8-39c1108e4ad3":{"type":"rich-text","blocks":{"template--18463718375692__cf988c16-5b76-4c17-b8a8-39c1108e4ad3-heading-1":{"type":"heading","disabled":true,"settings":{"text":"Свобода и удобство по време на шофиране","heading_tag":"h2","text_color":"","gradient":""}},"610e9943-4c1f-4b41-a51f-faa379a1ddef":{"type":"image","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/DALL_E_2024-11-23_20.20.11_-_A_highly_realistic_image_of_a_car_interior_showing_a_messy_central_console_filled_with_tangled_cables_and_a_frustrated_driver_on_the_left._On_the_righ.webp","width_mode":"custom","max_width":600,"mobile_max_width":400}},"template--18463718375692__cf988c16-5b76-4c17-b8a8-39c1108e4ad3-richtext-1":{"type":"richtext","disabled":true,"settings":{"content":"<p>Представете си всяко пътуване, започващо с досадно разплитане на кабели или търсене на подходящия кабел за вашето устройство. Вместо да се възползвате от безжична свързаност, ще останете обвързани с ограниченията на кабелите, които усложняват живота ви и ви разсейват от по-важното – шофирането.<\/p>"}}},"block_order":["template--18463718375692__cf988c16-5b76-4c17-b8a8-39c1108e4ad3-heading-1","610e9943-4c1f-4b41-a51f-faa379a1ddef","template--18463718375692__cf988c16-5b76-4c17-b8a8-39c1108e4ad3-richtext-1"],"settings":{"full_width":true,"content_width":"small","text_position":"center","background":"#ffffff","background_gradient":"","text_color":""}},"bcddf843-1225-4d46-8b88-b09ae3976093":{"type":"rich-text","blocks":{"template--18463718375692__bcddf843-1225-4d46-8b88-b09ae3976093-heading-1":{"type":"heading","settings":{"text":"Как работи?","heading_tag":"h2","text_color":"","gradient":""}},"template--18463718375692__bcddf843-1225-4d46-8b88-b09ae3976093-richtext-1":{"type":"richtext","settings":{"content":"<ol><li>Закрепете сенника към стандартния сенник на автомобила.<\/li><li>Използвайте <strong>сивия филтър<\/strong> през деня за защита от слънцето.<\/li><li>Спуснете <strong>жълтия филтър<\/strong> през нощта за намаляване на заслепяващите фарове.<\/li><\/ol>"}},"image_GTqfHd":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/8.png","width_mode":"custom","max_width":580,"mobile_max_width":600}}},"block_order":["template--18463718375692__bcddf843-1225-4d46-8b88-b09ae3976093-heading-1","template--18463718375692__bcddf843-1225-4d46-8b88-b09ae3976093-richtext-1","image_GTqfHd"],"settings":{"full_width":true,"content_width":"small","text_position":"center","background":"#ffffff","background_gradient":"","text_color":""}},"59baa1c6-3b1f-44fe-84a2-78a02e120c31":{"type":"slideshow","blocks":{"template--18463718375692__59baa1c6-3b1f-44fe-84a2-78a02e120c31-image-1":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/gift-voucher-in-burgundy-envelope-with-blue-bow-royalty-free-image-1696863980.jpg","content_max_width":780,"mobile_text_position":"place-self-center text-center","desktop_text_position":"sm:place-self-center sm:text-center","subheading":"","title":"Unique Christmas Gift","heading_tag":"h0","button_text":"","button_link":"","text_color":"#ffffff","button_background":"#ffffff","button_text_color":"#000000","overlay_color":"#000000","overlay_opacity":30,"background":"","background_gradient":""}}},"block_order":["template--18463718375692__59baa1c6-3b1f-44fe-84a2-78a02e120c31-image-1"],"disabled":true,"settings":{"full_width":true,"allow_transparent_header":true,"image_size":"auto","controls_type":"dots","transition_type":"fade_with_text","autoplay":false,"cycle_speed":6,"background":"#f2f2f2","background_gradient":""}},"6e5c416b-1adc-4797-8d37-f5ca7d95603a":{"type":"faq","blocks":{"template--18463718375692__6e5c416b-1adc-4797-8d37-f5ca7d95603a-item-1":{"type":"item","settings":{"title":"Как се монтира сенникът?","content":"<p>Монтажът е изключително лесен – просто го захванете върху съществуващия сенник на автомобила.<\/p>"}},"template--18463718375692__6e5c416b-1adc-4797-8d37-f5ca7d95603a-item-2":{"type":"item","settings":{"title":"Подходящ ли е за всички видове автомобили?","content":"<p>Да, сенникът е универсален и може да се използва с повечето автомобили.<\/p>"}},"template--18463718375692__6e5c416b-1adc-4797-8d37-f5ca7d95603a-item-3":{"type":"item","disabled":true,"settings":{"title":"What exactly is the Magnetic Fluid Music Rhythm Companion Light?","content":"<p> It's a decorative piece that uses magnetic fluid to visually represent music and sound through its movement. The fluid inside the glass container reacts to the nearby sound vibrations, creating a dynamic and unique display.<\/p>"}},"4f7dfbd1-9da7-41c2-8371-2de7a72f5543":{"type":"item","settings":{"title":"Помага ли на хора с чувствителни очи?","content":"<p>Да, благодарение на поляризираните филтри, сенникът намалява напрежението в очите и осигурява по-комфортно шофиране.<\/p>"}},"976b89a1-86b7-4bf2-af56-7bfb5eecfd15":{"type":"item","settings":{"title":"Мога ли да използвам и двата филтъра едновременно?","content":"<p>Не, двата филтъра са предназначени за различни условия – жълтият за нощно шофиране, а сивият за дневна употреба.<\/p>"}},"item_Uj79KW":{"t