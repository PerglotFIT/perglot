{% comment %}
  Devices Section - Show all supported devices
  Fully customizable through Shopify customizer
{% endcomment %}

<div class="devices-section-wrapper" data-section-id="{{ section.id }}">
  <div class="devices-container">
    {% if section.settings.show_section_title %}
      <div class="devices-header">
        {% if section.settings.section_title != blank %}
          <h2 class="devices-title">{{ section.settings.section_title }}</h2>
        {% endif %}
        {% if section.settings.section_description != blank %}
          <p class="devices-description">{{ section.settings.section_description }}</p>
        {% endif %}
      </div>
    {% endif %}
    
    <div class="devices-grid">
      {% for block in section.blocks %}
        <div class="device-card" {{ block.shopify_attributes }}>
          {% if block.settings.device_icon != blank %}
            <div class="device-icon">{{ block.settings.device_icon }}</div>
          {% endif %}
          
          {% if block.settings.device_name != blank %}
            <h3 class="device-name">{{ block.settings.device_name }}</h3>
          {% endif %}
          
          {% if block.settings.device_description != blank %}
            <p class="device-description">{{ block.settings.device_description }}</p>
          {% endif %}
          
          {% if block.settings.show_badge %}
            <span class="device-badge">{{ block.settings.badge_text }}</span>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    
    {% if section.settings.show_bottom_text and section.settings.bottom_text != blank %}
      <div class="devices-bottom-text">
        <p>{{ section.settings.bottom_text }}</p>
      </div>
    {% endif %}
  </div>
</div>

<style>
.devices-section-wrapper {
  padding: {{ section.settings.section_padding_top }}px 20px {{ section.settings.section_padding_bottom }}px;
  background: {{ section.settings.background_color }};
}

.devices-container {
  max-width: {{ section.settings.container_max_width }}px;
  margin: 0 auto;
}

.devices-header {
  text-align: center;
  margin-bottom: {{ section.settings.header_margin_bottom }}px;
}

.devices-title {
  font-size: {{ section.settings.title_font_size }}px;
  font-weight: {{ section.settings.title_font_weight }};
  color: {{ section.settings.title_color }};
  margin-bottom: 15px;
  line-height: 1.2;
}

.devices-description {
  font-size: {{ section.settings.description_font_size }}px;
  color: {{ section.settings.description_color }};
  max-width: 700px;
  margin: 0 auto;
  line-height: 1.6;
}

/* Devices Grid */
.devices-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
  gap: {{ section.settings.gap_between_cards }}px;
}

/* Device Card */
.device-card {
  background: {{ section.settings.card_bg_color }};
  border-radius: {{ section.settings.card_border_radius }}px;
  padding: {{ section.settings.card_padding }}px;
  border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
  box-shadow: {{ section.settings.card_shadow }};
  text-align: center;
  transition: all 0.3s ease;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: {{ section.settings.card_min_height }}px;
}

.device-card:hover {
  transform: translateY(-5px);
  box-shadow: {{ section.settings.card_hover_shadow }};
  border-color: {{ section.settings.card_hover_border_color }};
}

/* Device Icon */
.device-icon {
  font-size: {{ section.settings.icon_size }}px;
  margin-bottom: {{ section.settings.icon_margin_bottom }}px;
  line-height: 1;
  {% if section.settings.icon_circle_bg %}
    width: {{ section.settings.icon_circle_size }}px;
    height: {{ section.settings.icon_circle_size }}px;
    background: {{ section.settings.icon_circle_bg_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  {% endif %}
}

/* Device Name */
.device-name {
  font-size: {{ section.settings.device_name_font_size }}px;
  font-weight: {{ section.settings.device_name_font_weight }};
  color: {{ section.settings.device_name_color }};
  margin-bottom: {{ section.settings.device_name_margin_bottom }}px;
  line-height: 1.3;
}

/* Device Description */
.device-description {
  font-size: {{ section.settings.device_description_font_size }}px;
  color: {{ section.settings.device_description_color }};
  line-height: 1.5;
  margin: 0;
}

/* Device Badge */
.device-badge {
  position: absolute;
  top: {{ section.settings.badge_top }}px;
  right: {{ section.settings.badge_right }}px;
  background: {{ section.settings.badge_bg_color }};
  color: {{ section.settings.badge_text_color }};
  font-size: {{ section.settings.badge_font_size }}px;
  font-weight: {{ section.settings.badge_font_weight }};
  padding: {{ section.settings.badge_padding_vertical }}px {{ section.settings.badge_padding_horizontal }}px;
  border-radius: {{ section.settings.badge_border_radius }}px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* Bottom Text */
.devices-bottom-text {
  text-align: center;
  margin-top: {{ section.settings.bottom_text_margin_top }}px;
  padding: {{ section.settings.bottom_text_padding }}px;
  background: {{ section.settings.bottom_text_bg_color }};
  border-radius: {{ section.settings.bottom_text_border_radius }}px;
}

.devices-bottom-text p {
  font-size: {{ section.settings.bottom_text_font_size }}px;
  color: {{ section.settings.bottom_text_color }};
  margin: 0;
  line-height: 1.6;
}

/* Tablet Responsive */
@media (max-width: 1024px) and (min-width: 769px) {
  .devices-grid {
    grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
  }
}

/* Mobile Responsive */
@media (max-width: 768px) {
  .devices-title {
    font-size: {{ section.settings.title_font_size | times: 0.75 }}px;
  }
  
  .devices-description {
    font-size: {{ section.settings.description_font_size | times: 0.9 }}px;
  }
  
  .devices-grid {
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    gap: {{ section.settings.gap_between_cards | times: 0.7 }}px;
  }
  
  .device-card {
    padding: {{ section.settings.card_padding | times: 0.8 }}px;
    min-height: auto;
  }
  
  .device-icon {
    font-size: {{ section.settings.icon_size | times: 0.85 }}px;
    {% if section.settings.icon_circle_bg %}
      width: {{ section.settings.icon_circle_size | times: 0.85 }}px;
      height: {{ section.settings.icon_circle_size | times: 0.85 }}px;
    {% endif %}
  }
  
  .device-name {
    font-size: {{ section.settings.device_name_font_size | times: 0.9 }}px;
  }
  
  .device-description {
    font-size: {{ section.settings.device_description_font_size | times: 0.95 }}px;
  }
  
  .device-badge {
    font-size: {{ section.settings.badge_font_size | times: 0.9 }}px;
    padding: {{ section.settings.badge_padding_vertical | times: 0.8 }}px {{ section.settings.badge_padding_horizontal | times: 0.8 }}px;
  }
}

@media (max-width: 480px) {
  .devices-section-wrapper {
    padding: {{ section.settings.section_padding_top | times: 0.6 }}px 15px {{ section.settings.section_padding_bottom | times: 0.6 }}px;
  }
  
  .devices-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
</style>

