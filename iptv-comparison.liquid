      "id": "value_text_font_size",
      "min": 14,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Размер на текстови стойности",
      "default": 16
    },
    {
      "type": "range",
      "id": "premium_value_font_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Размер на Premium стойности",
      "default": 18
    },
    {
      "type": "select",
      "id": "premium_text_font_weight",
      "label": "Дебелина на Premium текст",
      "options": [
        {
          "value": "600",
          "label": "Полу-удебелено"
        },
        {
          "value": "700",
          "label": "Удебелено"
        },
        {
          "value": "800",
          "label": "Много удебелено"
        }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "icon_font_size",
      "min": 18,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Размер на икони (✓/✕)",
      "default": 24
    },
    {
      "type": "range",
      "id": "premium_icon_font_size",
      "min": 20,
      "max": 36,
      "step": 2,
      "unit": "px",
      "label": "Размер на Premium икони",
      "default": 28
    },
    {
      "type": "header",
      "content": "Размери - Контейнер"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 800,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Максимална широчина",
      "default": 1200
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Горна подложка",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Долна подложка",
      "default": 80
    },
    {
      "type": "header",
      "content": "Размери - Таблица"
    },
    {
      "type": "range",
      "id": "table_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Заоблени ъгли на таблица",
      "default": 16
    },
    {
      "type": "text",
      "id": "table_shadow",
      "label": "Сянка на таблица",
      "default": "0 10px 40px rgba(0,0,0,0.1)",
      "info": "CSS box-shadow стойност"
    },
