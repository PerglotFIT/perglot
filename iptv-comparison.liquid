      "id": "description_font_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Размер на описание",
      "default": 18
    },
    {
      "type": "header",
      "content": "Шрифтове - Header на таблица"
    },
    {
      "type": "range",
      "id": "header_font_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Размер на текст в header",
      "default": 18
    },
    {
      "type": "select",
      "id": "header_font_weight",
      "label": "Дебелина на текст в header",
      "options": [
        {
          "value": "600",
          "label": "Полу-удебелено"
        },
        {
          "value": "700",
          "label": "Удебелено"
        },
        {
          "value": "800",
          "label": "Много удебелено"
        }
      ],
      "default": "700"
    },
    {
      "type": "header",
      "content": "Шрифтове - Характеристики"
    },
    {
      "type": "range",
      "id": "feature_icon_size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Размер на икони",
      "default": 20
    },
    {
      "type": "range",
      "id": "feature_name_font_size",
      "min": 14,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Размер на име на характеристика",
      "default": 16
    },
    {
      "type": "select",
      "id": "feature_name_font_weight",
      "label": "Дебелина на име на характеристика",
      "options": [
        {
          "value": "400",
          "label": "Нормално"
