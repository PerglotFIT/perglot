{% comment %}
  BMW AiBox - Key Features Section
  Fully editable with images instead of icons
{% endcomment %}

<style>
  .features-section-{{ section.id }} {
    background: {{ section.settings.background_gradient_start }} linear-gradient(180deg, {{ section.settings.background_gradient_start }} 0%, {{ section.settings.background_gradient_end }} 100%);
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }
  
  .features-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
  }
  
  .features-header {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .features-badge {
    display: inline-block;
    background: linear-gradient(135deg, {{ section.settings.badge_color_start }} 0%, {{ section.settings.badge_color_end }} 100%);
    color: white;
    padding: 8px 20px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 20px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  
  .features-title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: 800;
    color: {{ section.settings.title_color }};
    margin-bottom: 20px;
    line-height: 1.2;
  }
  
  .features-description {
    font-size: {{ section.settings.description_size }}px;
    color: {{ section.settings.description_color }};
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.7;
  }
  
  .features-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 25px;
    margin-bottom: 50px;
  }
  
  .feature-card {
    background: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_border_radius }}px;
    padding: 35px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
  }
  
  .feature-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.12);
  }
  
  .feature-card.popular {
    border: 3px solid {{ section.settings.popular_border_color }};
  }
  
  .feature-card:hover .feature-image-wrapper {
    transform: scale(1.1);
  }
  
  .feature-image-wrapper {
    width: 100%;
    height: {{ section.settings.image_height }}px;
    border-radius: {{ section.settings.image_border_radius }}px;
    overflow: hidden;
    margin-bottom: 25px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    transition: all 0.4s ease;
    position: relative;
  }
  
  .feature-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .popular-badge {
    position: absolute;
    top: 15px;
    right: 15px;
    background: linear-gradient(135deg, {{ section.settings.popular_badge_start }} 0%, {{ section.settings.popular_badge_end }} 100%);
    color: white;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    animation: pulse 2s ease-in-out infinite;
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }
  
  .feature-title {
    font-size: {{ section.settings.feature_title_size }}px;
    font-weight: 700;
    color: {{ section.settings.feature_title_color }};
    margin-bottom: 15px;
  }
  
  .feature-description {
    font-size: {{ section.settings.feature_description_size }}px;
    color: {{ section.settings.feature_description_color }};
    line-height: 1.7;
    margin-bottom: 20px;
  }
  
  .feature-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  
  .feature-tag {
    background: {{ section.settings.tag_background }};
    color: {{ section.settings.tag_color }};
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
  }
  
  .features-cta {
    text-align: center;
    margin-top: 60px;
  }
  
  .cta-box {
    display: inline-block;
    background: {{ section.settings.cta_box_background }};
    padding: 40px 50px;
    border-radius: 20px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.1);
  }
  
  .cta-title {
    font-size: 26px;
    font-weight: 700;
    color: {{ section.settings.cta_title_color }};
    margin-bottom: 15px;
  }
  
  .cta-description {
    font-size: 16px;
    color: {{ section.settings.cta_description_color }};
    margin-bottom: 25px;
    max-width: 500px;
  }
  
  .cta-button {
    background: linear-gradient(135deg, {{ section.settings.cta_button_start }} 0%, {{ section.settings.cta_button_end }} 100%);
    color: white;
    border: none;
    padding: 18px 45px;
    border-radius: 12px;
    font-size: 18px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(37, 99, 235, 0.4);
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
  }
  
  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 40px rgba(37, 99, 235, 0.5);
  }
  
  .cta-features {
    margin-top: 15px;
    font-size: 14px;
    color: #999;
  }
  
  @media (max-width: 768px) {
    .features-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    }
    
    .features-title {
      font-size: {{ section.settings.title_size | divided_by: 1.3 }}px;
    }
    
    .cta-box {
      padding: 30px 25px;
    }
  }
</style>

<section class="features-section-{{ section.id }}">
  <div class="features-container">
    
    {% if section.settings.show_header %}
    <!-- Section Header -->
    <div class="features-header">
      {% if section.settings.badge_text != blank %}
      <div class="features-badge">
        {{ section.settings.badge_text }}
      </div>
      {% endif %}
      
      {% if section.settings.title != blank %}
      <h2 class="features-title">
        {{ section.settings.title }}
      </h2>
      {% endif %}
      
      {% if section.settings.description != blank %}
      <p class="features-description">
        {{ section.settings.description }}
      </p>
      {% endif %}
    </div>
    {% endif %}

    <!-- Features Grid -->
    <div class="features-grid">
      {% for block in section.blocks %}
        {% if block.type == 'feature' %}
        <div class="feature-card {% if block.settings.is_popular %}popular{% endif %}" {{ block.shopify_attributes }}>
          
          {% if block.settings.is_popular and block.settings.popular_text != blank %}
          <div class="popular-badge">
            {{ block.settings.popular_text }}
          </div>
          {% endif %}
          
          <!-- Feature Image -->
          {% if block.settings.image != blank %}
          <div class="feature-image-wrapper">
            {{ block.settings.image | image_url: width: 1200 | image_tag: 
              alt: block.settings.title,
              loading: 'lazy'
            }}
          </div>
          {% endif %}
          
          <!-- Feature Content -->
          {% if block.settings.title != blank %}
          <h3 class="feature-title">
            {{ block.settings.title }}
          </h3>
          {% endif %}
          
          {% if block.settings.description != blank %}
          <p class="feature-description">
            {{ block.settings.description }}
          </p>
          {% endif %}
          
          <!-- Tags -->
          {% if block.settings.tag_1 != blank or block.settings.tag_2 != blank %}
          <div class="feature-tags">
            {% if block.settings.tag_1 != blank %}
            <span class="feature-tag" style="background: {{ block.settings.tag_1_bg }}; color: {{ block.settings.tag_1_color }};">
              {{ block.settings.tag_1 }}
            </span>
            {% endif %}
            
            {% if block.settings.tag_2 != blank %}
            <span class="feature-tag" style="background: {{ block.settings.tag_2_bg }}; color: {{ block.settings.tag_2_color }};">
              {{ block.settings.tag_2 }}
            </span>
            {% endif %}
          </div>
          {% endif %}
          
        </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_cta %}
    <!-- CTA at the bottom -->
    <div class="features-cta">
      <div class="cta-box">
        {% if section.settings.cta_title != blank %}
        <h3 class="cta-title">
          {{ section.settings.cta_title }}
        </h3>
        {% endif %}
        
        {% if section.settings.cta_description != blank %}
        <p class="cta-description">
          {{ section.settings.cta_description }}
        </p>
        {% endif %}
        
        {% if section.settings.cta_button_text != blank %}
        <a href="{{ section.settings.cta_button_link }}" class="cta-button">
          {{ section.settings.cta_button_text }}
        </a>
        {% endif %}
        
        {% if section.settings.cta_features != blank %}
        <div class="cta-features">
          {{ section.settings.cta_features }}
        </div>
        {% endif %}
      </div>
    </div>
    {% endif %}

  </div>
</section>

