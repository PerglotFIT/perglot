{% comment %}
  Featured Products Section
  Fully customizable product showcase with 3 products per row
{% endcomment %}

<section class="featured-products-{{ section.id }}" style="
  padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  background: {{ section.settings.background_color }};
">
  <div class="container container-{{ section.id }}" style="max-width: {{ section.settings.container_width }}px; margin: 0 auto; padding: 0 20px;">
    <div class="section-header section-header-{{ section.id }}" style="
      margin-bottom: {{ section.settings.header_margin_bottom }}px;
      text-align: center !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      width: 100% !important;
    ">
      <h2 class="section-title section-title-{{ section.id }}" style="
        font-size: {{ section.settings.title_font_size }}px;
        font-weight: {{ section.settings.title_font_weight }};
        margin-bottom: {{ section.settings.title_margin_bottom }}px;
        color: {{ section.settings.title_color }};
        text-align: center !important;
        display: block !important;
        width: 100% !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
      ">{{ section.settings.title }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="section-subtitle section-subtitle-{{ section.id }}" style="
          font-size: {{ section.settings.subtitle_font_size }}px;
          color: {{ section.settings.subtitle_color }};
          max-width: {{ section.settings.subtitle_max_width }}px;
          margin: 0 auto;
          line-height: {{ section.settings.subtitle_line_height }};
          text-align: center !important;
          display: block !important;
        ">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>
    
    <div class="products-grid" style="
      display: grid;
      grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
      gap: {{ section.settings.grid_gap }}px;
    ">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% if product != blank %}
        <div class="product-card product-card-{{ section.id }}" {{ block.shopify_attributes }} style="
          background: {{ section.settings.card_background }};
          border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
          border-radius: {{ section.settings.card_border_radius }}px;
        ">
          {% if block.settings.badge != blank %}
            <span class="product-badge" style="
              background: {{ section.settings.badge_background }};
              color: {{ section.settings.badge_text_color }};
              padding: {{ section.settings.badge_padding_vertical }}px {{ section.settings.badge_padding_horizontal }}px;
              border-radius: {{ section.settings.badge_border_radius }}px;
              font-size: {{ section.settings.badge_font_size }}px;
              font-weight: {{ section.settings.badge_font_weight }};
            ">{{ block.settings.badge }}</span>
          {% endif %}
          
          {% if product.featured_image != blank %}
            <img src="{{ product.featured_image | img_url: '600x' }}" 
                 alt="{{ product.title }}" 
                 class="product-image product-image-{{ section.id }}"
                 loading="lazy"
                 style="
                   height: {{ section.settings.image_height }}px;
                 ">
          {% else %}
            <div class="product-image product-placeholder" style="
              height: {{ section.settings.image_height }}px;
              background: {{ section.settings.placeholder_gradient }};
            "></div>
          {% endif %}
          
          <div class="product-content" style="
            padding: {{ section.settings.content_padding }}px;
            text-align: {{ section.settings.content_text_alignment }};
          ">
            <h3 class="product-title" style="
              font-size: {{ section.settings.product_title_font_size }}px;
              font-weight: {{ section.settings.product_title_font_weight }};
              margin-bottom: {{ section.settings.product_title_margin_bottom }}px;
              color: {{ section.settings.product_title_color }};
              text-align: {{ section.settings.product_title_alignment }};
            ">{{ product.title }}</h3>
            
            {% if block.settings.features != blank %}
              <ul class="product-features" style="
                margin-bottom: {{ section.settings.features_margin_bottom }}px;
              ">
                {% assign features_list = block.settings.features | split: '|' %}
                {% for feature in features_list %}
                  <li style="
                    font-size: {{ section.settings.features_font_size }}px;
                    color: {{ section.settings.features_text_color }};
                    margin-bottom: {{ section.settings.features_item_spacing }}px;
                    padding-left: {{ section.settings.features_padding_left }}px;
                  ">{{ feature }}</li>
                {% endfor %}
              </ul>
            {% endif %}
            
            
            {% assign button_text = block.settings.button_text | default: 'Buy Now' %}
            <a href="{{ product.url }}" 
               class="btn btn-primary btn-{{ section.id }}" 
               style="
                 width: 100%;
                 text-align: center;
                 padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
                 background: {{ section.settings.button_background }};
                 color: {{ section.settings.button_text_color }};
                 border-radius: {{ section.settings.button_border_radius }}px;
                 font-size: {{ section.settings.button_font_size }}px;
                 font-weight: {{ section.settings.button_font_weight }};
                 text-decoration: none;
                 border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
               ">
              {{ button_text }}
            </a>
          </div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .featured-products-{{ section.id }} .container-{{ section.id }} {
    display: block !important;
    float: none !important;
  }

  .featured-products-{{ section.id }} .section-header-{{ section.id }} {
    text-align: center !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100% !important;
    float: none !important;
  }

  .featured-products-{{ section.id }} .section-title-{{ section.id }} {
    text-align: center !important;
    display: block !important;
    width: 100% !important;
    float: none !important;
    clear: both !important;
  }

  .featured-products-{{ section.id }} .section-subtitle-{{ section.id }} {
    text-align: center !important;
    display: block !important;
    float: none !important;
    clear: both !important;
  }

  .product-card-{{ section.id }} {
    overflow: hidden;
    position: relative;
    transition: all {{ section.settings.transition_duration }}s {{ section.settings.transition_timing }};
  }

  {% if section.settings.enable_hover_effect %}
  .product-card-{{ section.id }}:hover {
    box-shadow: {{ section.settings.hover_shadow }};
    transform: translateY({{ section.settings.hover_translate_y }}px);
  }
  {% endif %}

  .product-badge {
    position: absolute;
    top: {{ section.settings.badge_position_top }}px;
    right: {{ section.settings.badge_position_right }}px;
    z-index: 5;
  }

  .product-image-{{ section.id }} {
    width: 100%;
    object-fit: cover;
    background: #f8f9fa;
  }

  .product-placeholder {
    width: 100%;
  }

  .product-features {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .product-features li {
    position: relative;
    text-align: left;
  }

  {% if section.settings.show_checkmarks %}
  .product-features li::before {
    content: "{{ section.settings.checkmark_symbol }}";
    position: absolute;
    left: 0;
    color: {{ section.settings.checkmark_color }};
    font-weight: {{ section.settings.checkmark_font_weight }};
  }
  {% endif %}

  .btn-{{ section.id }} {
    transition: all {{ section.settings.button_transition_duration }}s;
    cursor: pointer;
    display: block;
  }

  {% if section.settings.enable_button_hover %}
  .btn-{{ section.id }}:hover {
    background: {{ section.settings.button_hover_background }};
    color: {{ section.settings.button_hover_text_color }};
    transform: translateY({{ section.settings.button_hover_translate_y }}px);
  }
  {% endif %}

  @media (max-width: {{ section.settings.tablet_breakpoint }}px) {
    .products-grid {
      grid-template-columns: repeat({{ section.settings.tablet_columns }}, 1fr) !important;
      gap: {{ section.settings.tablet_grid_gap }}px !important;
    }
  }

  @media (max-width: {{ section.settings.mobile_breakpoint }}px) {
    .featured-products-{{ section.id }} {
      padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px !important;
    }
    
    .section-title-{{ section.id }} {
      font-size: {{ section.settings.mobile_title_font_size }}px !important;
    }
    
    .section-subtitle-{{ section.id }} {
      font-size: {{ section.settings.mobile_subtitle_font_size }}px !important;
    }
    
    .products-grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr) !important;
      gap: {{ section.settings.mobile_grid_gap }}px !important;
    }
    
    .product-image-{{ section.id }},
    .product-placeholder {
      height: {{ section.settings.mobile_image_height }}px !important;
    }
    
    .product-content {
      padding: {{ section.settings.mobile_content_padding }}px !important;
    }
  }
</style>

{% schema %}
