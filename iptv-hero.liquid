{% comment %}
  IPTV Hero Section - Customizable
{% endcomment %}

<style>
  .iptv-hero-{{ section.id }} {
    background: {{ section.settings.background_gradient_start }};
    background: linear-gradient(135deg, {{ section.settings.background_gradient_start }} 0%, {{ section.settings.background_gradient_end }} 100%);
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  .iptv-hero-{{ section.id }}::before {
    content: '';
    position: absolute;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, {{ section.settings.accent_color }}26 0%, transparent 70%);
    border-radius: 50%;
    top: -200px;
    right: -200px;
  }

  .iptv-hero-{{ section.id }}::after {
    content: '';
    position: absolute;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, {{ section.settings.secondary_color }}1a 0%, transparent 70%);
    border-radius: 50%;
    bottom: -150px;
    left: -150px;
  }

  .iptv-hero-content-{{ section.id }} {
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .iptv-hero-badge-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    background: {{ section.settings.badge_background }};
    border: 1px solid {{ section.settings.badge_border }};
    padding: 8px 20px;
    border-radius: 50px;
    color: {{ section.settings.badge_text_color }};
    font-size: {{ section.settings.badge_font_size }}px;
    font-weight: 600;
    margin-bottom: 30px;
  }

  .iptv-hero-badge-{{ section.id }} svg {
    width: 20px;
    height: 20px;
    margin-right: 8px;
  }

  .iptv-hero-{{ section.id }} h1 {
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: 800;
    color: {{ section.settings.heading_color }};
    margin-bottom: 20px;
    line-height: 1.2;
  }

  .iptv-hero-{{ section.id }} .highlight {
    background: linear-gradient(135deg, {{ section.settings.highlight_gradient_start }} 0%, {{ section.settings.highlight_gradient_end }} 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .iptv-hero-subtitle-{{ section.id }} {
    font-size: {{ section.settings.subtitle_font_size }}px;
    color: {{ section.settings.subtitle_color }};
    max-width: 700px;
    margin-bottom: 40px;
    line-height: 1.6;
  }

  .iptv-hero-stats-{{ section.id }} {
    display: flex;
    gap: 40px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .stat-item-{{ section.id }} {
    display: flex;
    flex-direction: column;
  }

  .stat-number-{{ section.id }} {
    font-size: {{ section.settings.stat_number_size }}px;
    font-weight: 800;
    color: {{ section.settings.stat_number_color }};
    line-height: 1;
    margin-bottom: 5px;
  }

  .stat-label-{{ section.id }} {
    font-size: {{ section.settings.stat_label_size }}px;
    color: {{ section.settings.stat_label_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .iptv-hero-cta-{{ section.id }} {
    display: flex;
    gap: 20px;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-primary-{{ section.id }} {
    background: linear-gradient(135deg, {{ section.settings.primary_btn_gradient_start }} 0%, {{ section.settings.primary_btn_gradient_end }} 100%);
    color: {{ section.settings.primary_btn_text_color }};
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    border-radius: {{ section.settings.button_border_radius }}px;
    text-decoration: none;
    font-weight: 700;
    font-size: {{ section.settings.button_font_size }}px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px {{ section.settings.primary_btn_shadow }};
  }

  .btn-primary-{{ section.id }}:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 40px {{ section.settings.primary_btn_shadow }};
  }

  .btn-secondary-{{ section.id }} {
    color: {{ section.settings.secondary_btn_text_color }};
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    border: 2px solid {{ section.settings.secondary_btn_border }};
    border-radius: {{ section.settings.button_border_radius }}px;
    text-decoration: none;
    font-weight: 600;
    font-size: {{ section.settings.button_font_size }}px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: all 0.3s ease;
    background: {{ section.settings.secondary_btn_background }};
    backdrop-filter: blur(10px);
  }

  .btn-secondary-{{ section.id }}:hover {
    background: {{ section.settings.secondary_btn_hover_bg }};
    border-color: {{ section.settings.secondary_btn_hover_border }};
  }

  /* Responsive */
  @media (max-width: 768px) {
    .iptv-hero-{{ section.id }} h1 {
      font-size: {{ section.settings.heading_font_size | divided_by: 1.5 }}px;
    }

    .iptv-hero-subtitle-{{ section.id }} {
      font-size: {{ section.settings.subtitle_font_size | minus: 4 }}px;
    }

    .iptv-hero-cta-{{ section.id }} {
      flex-direction: column;
      width: 100%;
    }

    .btn-primary-{{ section.id }},
    .btn-secondary-{{ section.id }} {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<section class="iptv-hero-{{ section.id }}">
  <div class="iptv-hero-content-{{ section.id }}">
    {% if section.settings.show_badge %}
      <div class="iptv-hero-badge-{{ section.id }}">
        {% if section.settings.show_badge_icon %}
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        {% endif %}
        {{ section.settings.badge_text }}
      </div>
    {% endif %}
    
    <h1>
      {% assign line1 = section.settings.heading_line_1 | replace: '[[', '<span class="highlight">' | replace: ']]', '</span>' %}
      {{ line1 }}
      {% if section.settings.heading_line_2 != blank %}
        <br>
        {% assign line2 = section.settings.heading_line_2 | replace: '[[', '<span class="highlight">' | replace: ']]', '</span>' %}
        {{ line2 }}
      {% endif %}
    </h1>
    
    {% if section.settings.subtitle != blank %}
      <p class="iptv-hero-subtitle-{{ section.id }}">
        {{ section.settings.subtitle }}
      </p>
    {% endif %}
    
    {% if section.settings.show_stats %}
      <div class="iptv-hero-stats-{{ section.id }}">
        {% for block in section.blocks %}
          {% if block.type == 'stat' %}
            <div class="stat-item-{{ section.id }}">
              <div class="stat-number-{{ section.id }}">{{ block.settings.stat_number }}</div>
              <div class="stat-label-{{ section.id }}">{{ block.settings.stat_label }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
    
    <div class="iptv-hero-cta-{{ section.id }}">
      {% if section.settings.primary_button_text != blank %}
        <a href="{{ section.settings.primary_button_link }}" class="btn-primary-{{ section.id }}">
          {{ section.settings.primary_button_text }}
          {% if section.settings.show_primary_icon %}
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          {% endif %}
        </a>
      {% endif %}
      
      {% if section.settings.secondary_button_text != blank %}
        <a href="{{ section.settings.secondary_button_link }}" class="btn-secondary-{{ section.id }}">
          {{ section.settings.secondary_button_text }}
          {% if section.settings.show_secondary_icon %}
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polygon points="10 8 16 12 10 16 10 8"></polygon>
            </svg>
          {% endif %}
        </a>
      {% endif %}
    </div>
  </div>
</section>

