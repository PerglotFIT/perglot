{% comment %}
  Customer Reviews Section
  Displays customer testimonials with ratings
{% endcomment %}

<section class="reviews-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{{ section.settings.title }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>
    
    <div class="reviews-grid">
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          <div class="review-card" {{ block.shopify_attributes }}>
            <div class="review-stars">
              {% for i in (1..5) %}★{% endfor %}
            </div>
            <p class="review-text">{{ block.settings.text }}</p>
            <div class="review-author">
              <div class="review-avatar">{{ block.settings.author_initial }}</div>
              <div class="author-info">
                <div class="author-name">{{ block.settings.author_name }}</div>
                <div class="author-location">{{ block.settings.author_location }}</div>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_stats %}
      <div class="reviews-stats">
        <h3>{{ section.settings.stats_title }}</h3>
        <p>{{ section.settings.stats_text }}</p>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .reviews-section {
    padding: 80px 0;
    background: white;
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 30px;
  }

  .review-card {
    background: #f8f9fa;
    padding: 30px;
    border-radius: 12px;
    border-left: 4px solid #F4C430;
  }

  .review-stars {
    color: #F4C430;
    font-size: 18px;
    margin-bottom: 15px;
  }

  .review-text {
    font-size: 15px;
    color: #1a1a1a;
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .review-author {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .review-avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: #2B5FA8;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 18px;
  }

  .author-info {
    flex: 1;
  }

  .author-name {
    font-weight: 600;
    margin-bottom: 3px;
  }

  .author-location {
    font-size: 13px;
    color: #666;
  }

  .reviews-stats {
    text-align: center;
    margin-top: 50px;
    padding: 40px;
    background: #2B5FA8;
    color: white;
    border-radius: 12px;
  }

  .reviews-stats h3 {
    font-size: 32px;
    margin-bottom: 10px;
  }

  @media (max-width: 768px) {
    .reviews-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Customer Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Какво казват нашите клиенти"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Реални отзиви от реални шофьори"
    },
    {
      "type": "header",
      "content": "Statistics Section"
    },
    {
      "type": "checkbox",
      "id": "show_stats",
      "label": "Show Statistics",
      "default": true
    },
    {
      "type": "textarea",
      "id": "stats_title",
      "label": "Stats Title",
      "default": "Над 10,000 шофьори в Европа се доверяват на Perglot"
    },
    {
      "type": "textarea",
      "id": "stats_text",
      "label": "Stats Text",
      "default": "35,000+ продадени продукта | 32,000+ доволни клиенти | 4.7★ средна оценка"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text",
          "default": "Great product! Works exactly as described."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "John Doe"
        },
        {
          "type": "text",
          "id": "author_initial",
          "label": "Author Initial",
          "default": "J",
          "info": "Single letter for avatar"
        },
        {
          "type": "text",
          "id": "author_location",
          "label": "Author Location",
          "default": "Sofia, Bulgaria"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "text": "Страхотен продукт! Устройството работи както е описано.",
            "author_name": "Мира",
            "author_initial": "М",
            "author_location": "София, България"
          }
        }
      ]
    }
  ]
}
{% endschema %}
